APP_ENV=development
DATABASE_URL=postgresql://ledgerpilot:ledgerpilot@postgres:5432/ledgerpilot
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
LLM_EXTRACTION_ENABLED=false
LLM_EXPLANATIONS_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:4317
ERP_MODE=mock
MATCH_PRICE_TOLERANCE_PCT=2.0
MATCH_QUANTITY_TOLERANCE_PCT=0.0
MATCH_TOTAL_TOLERANCE_PCT=2.0
MATCH_MAX_TAX_PCT=25.0
MATCH_MAX_FREIGHT_PCT=10.0
MATCH_MAX_DISCOUNT_PCT=30.0
AUTO_POST_ENABLED=true
REQUIRE_HUMAN_APPROVAL=false
MAX_UPLOAD_MB=15
# Optional shared-mailbox credentials. Leave blank for direct API-upload demos.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=ap-invoices@example.com
GRAPH_FOLDER=Inbox
